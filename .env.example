# Copy to `.env` (which is ignored by git). Both values are build-time only.

# The OAuth client the Google Drive sync signs in with. Google Cloud console →
# APIs & Services → Credentials → OAuth client ID of type "Web application",
# with the redirect URIs `https://<extension-id>.chromiumapp.org/` (Chrome and
# Brave) and the one `browser.identity.getRedirectURL()` prints in Firefox.
# Not a secret, but a fork should use a client of its own.
WXT_GOOGLE_CLIENT_ID=

# The store build's public key (Chrome Web Store → the item → Package → View
# public key). A dev build carrying it gets the store build's extension id, so
# the redirect URI registered above is the one Google sends it back to.
WXT_EXTENSION_KEY=
